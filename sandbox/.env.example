# Copy to sandbox/.env (0600). Tokens come from `bogo agent add`.
BOGO_AGENT_TOKEN=bogo_agt_...
# A second agent, used only by the bypass suite's session-reuse attempt.
BOGO_BYPASS_SECOND_TOKEN=bogo_agt_...
# BOGO's [server] port on the Mac.
BOGO_PORT=8790
# ARCHITECTURE §11 question 1: the one model API host the agent may reach.
MODEL_HOST=api.anthropic.com
